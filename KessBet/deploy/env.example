# KessBet 部署配置模板
#
# 复制成 .env 后填真实值（install.sh 会自动生成，一般不用手改）：
#   cp env.example .env && chmod 600 .env
#
# 值不要加引号，脚本用 shell source 读取。

# ---------- 数据库 ----------
KESSBET_DB_HOST=127.0.0.1
KESSBET_DB_PORT=3306
KESSBET_DB_NAME=sssj
KESSBET_DB_USER=kessbet
KESSBET_DB_PASSWORD=

# ---------- 网络 ----------
# Linux 服务器能直连 kessbet.com，不需要代理。留空即可。
# 如果确实要走代理，填 http://127.0.0.1:7890 这类地址。
KESSBET_PROXY=
